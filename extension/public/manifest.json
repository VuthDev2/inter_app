{
  "manifest_version": 3,
  "name": "QuickVoice AI Voice Interpreter",
  "version": "1.0.0",
  "description": "Live AI Voice Interpreter",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open QuickVoice"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "microphone"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
