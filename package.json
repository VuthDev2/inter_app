{
  "name": "quickvoice",
  "private": true,
  "description": "QuickVoice — real-time voice interpretation for mobile and web",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run mobile",
    "mobile": "npm --prefix apps/mobile run start",
    "mobile:clear": "npm --prefix apps/mobile run start -- --clear",
    "ios": "npm --prefix apps/mobile run ios",
    "android": "npm --prefix apps/mobile run android",
    "web": "npm --prefix apps/web run dev",
    "backend": "npm --prefix backend run dev",
    "typecheck": "npm --prefix apps/mobile run typecheck",
    "extension": "npm --prefix extension run dev",
    "extension:build": "npm --prefix extension run build",
    "install:all": "npm install && npm --prefix extension install && npm --prefix backend install"
  },
  "dependencies": {
    "@react-navigation/stack": "^7.10.17",
    "lightningcss": "^1.33.0",
    "expo": "~57.0.18",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "version": "1.0.0"
}
