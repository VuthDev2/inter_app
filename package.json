{
  "name": "quickvoice",
  "private": true,
  "description": "QuickVoice — real-time voice interpretation for mobile and web",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run mobile",
    "mobile": "npm --prefix apps/mobile run start",
    "ios": "npm --prefix apps/mobile run ios",
    "android": "npm --prefix apps/mobile run android",
    "web": "npm --prefix apps/web run dev",
    "backend": "npm --prefix backend run dev",
    "typecheck": "npm --prefix apps/mobile run typecheck"
  },
  "dependencies": {
    "@react-navigation/stack": "^7.10.17",
    "lightningcss": "^1.33.0"
  }
}
