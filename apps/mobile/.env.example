# QuickVoice runs ONE python-server (app/main.py) that serves speech
# recognition, translation, and TTS together on port 8000. There is no second
# service on 8001.
#
# Leave both URLs unset for local development. The app asks Metro which host it
# loaded the bundle from and looks for the server there on port 8000, so it
# works on any Wi-Fi network, from any device, with no edits here. A hard-coded
# IP goes stale as soon as the laptop reconnects to Wi-Fi.
#
# Only set these when Metro cannot point at the server (a tunnel, a staging
# box). Both must then point at the same host and port.
# EXPO_PUBLIC_API_BASE_URL=http://<host>:8000
# EXPO_PUBLIC_AI_BASE_URL=http://<host>:8000

# Supabase (find these in your Supabase project dashboard → Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
