# Node auth backend (signup / OTP / reset-password)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001

# QuickVoice-owned Whisper + NLLB + Kokoro model server
NEXT_PUBLIC_AI_BASE_URL=http://localhost:8000

# Set these instead of NEXT_PUBLIC_AI_BASE_URL when the model server sits
# behind a tunnel (e.g. Cloudflare) and requires QUICKVOICE_API_KEY auth.
# Server-only — never exposed to the browser bundle.
# QUICKVOICE_AI_INTERNAL_URL=https://your-tunnel.trycloudflare.com
# QUICKVOICE_AI_PUBLIC_URL=https://your-tunnel.trycloudflare.com
# QUICKVOICE_API_KEY=

# Supabase — same project as the mobile app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
